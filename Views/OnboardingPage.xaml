<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoViagem.Views.OnboardingPage"
             xmlns:viewmodels="clr-namespace:MinhaOnBoardingPage.ViewModels"
             xmlns:models="clr-namespace:ProjetoViagem.Models"
             x:DataType="viewmodels:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             Title="OnboardingPage">

    <Grid RowDefinitions="*, Auto,Auto" Padding="5,10">
        <CarouselView Grid.Row="0"
                      Position="{Binding Posicao}"
                      IndicatorView="Indicador"
                      Loop="False"
                      ItemsSource="{Binding Itens}">
            
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:OnboardingItem">
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="20">
                        
                        
                        
                        
                    <Image Source="{Binding ImagemUrl}"
                    Aspect="AspectFit"
                    HeightRequest="300"/>
                        
                        
                        <Label Text="{Binding Titulo}"
                               FontSize="32"
                               TextColor="#000"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"/>

           

            <Label Text="{Binding Descricao}"
                               FontSize="16"
                               TextColor="#000"
                               HorizontalTextAlignment="Center"/>


            </VerticalStackLayout>
                    
                </DataTemplate>
            </CarouselView.ItemTemplate>
            
        </CarouselView>

        <IndicatorView x:Name="Indicador"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       IndicatorColor="#FFE3ED"
                       SelectedIndicatorColor="#FF1568"
                       IndicatorSize="14"/>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="15">

            <Button Grid.Column="0"
                    Text="Gey Started"
                    BackgroundColor="#FF1568"/>

            <Button Grid.Column="1"
                    Command="{Binding ProximoCommand}"
                    Text="Next"
                    BackgroundColor="#4EA717"
                    IsVisible="{Binding ExibirBotao}"/>

        </Grid>

    </Grid>
   
</ContentPage>